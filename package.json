{
	"name": "doggopaste",
	"version": "0.7.0",
	"private": true,
	"description": "Drop your code, let Doggo fetch it! Combination of a Pastebin and CodeShare. Free and selfhostable.",
	"license": "MIT",
	"contributors": [
		{
			"name": "Witold Zawada",
			"url": "https://github.com/PoProstuWitold"
		},
		{
			"name": "Wiktor Wypyszyński",
			"url": "https://github.com/Netr0n07"
		}
	],
	"homepage": "https://github.com/PoProstuWitold/doggopaste",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PoProstuWitold/doggopaste.git"
	},
	"bugs": {
		"url": "https://github.com/PoProstuWitold/doggopaste/issues"
	},
	"keywords": [
		"pastebin",
		"codeshare",
		"code-sharing",
		"collaboration",
		"realtime",
		"self-hosted",
		"monorepo",
		"typescript"
	],
	"engines": {
		"node": ">=24 <25"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.24.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "24.x",
			"onFail": "download"
		}
	},
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"start": "turbo run start",
		"typecheck": "turbo run typecheck",
		"check": "biome check .",
		"check:fix": "biome check . --write"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"turbo": "^2.10.5",
		"typescript": "^7.0.2"
	}
}
